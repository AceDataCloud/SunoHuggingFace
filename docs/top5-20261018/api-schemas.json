    {
      "repo": "AceDataCloud/SeedanceDify",
      "path": "tools/api_contracts.py",
      "sha": "79395e642dd5c591f9ac8995fb8e812c866d7a4b",
      "url": "https://github.com/AceDataCloud/SeedanceDify/blob/main/tools/api_contracts.py",
      "local": "/tmp/ace-hf-top5-contracts-20261018/SeedanceDify-tools_api_contracts.py",
      "excerpt": "\"\"\"Published API contracts; source revisions are recorded in tests/parity-audit.json.\"\"\"\n\nTASK_PATH = \"/seedance/tasks\"\n\nENDPOINTS = {\n    \"seedance_generate_video\": {\n        \"method\": \"POST\",\n        \"path\": \"/seedance/videos\",\n        \"operation\": \"generate\",\n        \"schema\": {\n            \"type\": \"object\",\n            \"required\": [\"model\", \"content\"],\n            \"properties\": {\n                \"model\": {\n                    \"type\": \"string\",\n                    \"enum\": [\n                        \"doubao-seedance-1-0-pro-250528\",\n                        \"doubao-seedance-1-0-pro-fast-251015\",\n                        \"doubao-seedance-1-5-pro-251215\",\n                        \"doubao-seedance-1-0-lite-t2v-250428\",\n                        \"doubao-seedance-1-0-lite-i2v-250428\",\n                        \"doubao-seedance-2-0-260128\",\n                        \"doubao-seedance-2-0-fast-260128\",\n                        \"doubao-seedance-2-0-mini-260615\",\n                        \"doubao-seedance-2-5-260628\",\n                    ],\n                },\n                \"content\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                        \"oneOf\": [\n                            {\n                                \"type\": \"object\",\n                                \"required\": [\"type\", \"text\"],\n                                \"properties\": {\n                                    \"type\": {\"type\": \"string\", \"enum\": [\"text\"]},\n                                    \"text"
    },
    {
      "repo": "AceDataCloud/HappyHorseDify",
      "path": "tools/api_contracts.py",
      "sha": "7eb4d0661e704c8039b1bc3c2ed5015312f0e2bc",
      "url": "https://github.com/AceDataCloud/HappyHorseDify/blob/main/tools/api_contracts.py",
      "local": "/tmp/ace-hf-top5-contracts-20261018/HappyHorseDify-tools_api_contracts.py",
      "excerpt": "\"\"\"Published API contracts; source revisions are recorded in tests/parity-audit.json.\"\"\"\n\nTASK_PATH = \"/happyhorse/tasks\"\n\nENDPOINTS = {\n    \"happyhorse_generate_video\": {\n        \"method\": \"POST\",\n        \"path\": \"/happyhorse/videos\",\n        \"operation\": \"generate\",\n        \"schema\": {\n            \"type\": \"object\",\n            \"properties\": {\n                \"action\": {\n                    \"enum\": [\"generate\", \"image_to_video\", \"reference_to_video\", \"video_edit\"],\n                    \"type\": \"string\",\n                },\n                \"model\": {\n                    \"enum\": [\n                        \"happyhorse-1.0-t2v\",\n                        \"happyhorse-1.1-t2v\",\n                        \"happyhorse-1.0-i2v\",\n                        \"happyhorse-1.1-i2v\",\n                        \"happyhorse-1.0-r2v\",\n                        \"happyhorse-1.1-r2v\",\n                        \"happyhorse-1.0-video-edit\",\n                    ],\n                    \"type\": \"string\",\n                },\n                \"prompt\": {\"type\": \"string\"},\n                \"image_url\": {\"type\": \"string\"},\n                \"image_urls\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n                \"video_url\": {\"type\": \"string\"},\n                \"resolution\": {\"enum\": [\"720P\", \"1080P\"], \"type\": \"string\"},\n                \"ratio\": {\"enum\": [\"16:9\", \"9:16\", \"1:1\", \"4:3\", \"3:4\"], \"type\": \"string\"},\n                \"duration\": {\"type\": \"integer\", \"minimum\": 3, \"maximum\": 15},\n                \"watermark\": {\"type\":"
    },
    {
      "repo": "AceDataCloud/GPTImageDify",
      "path": "tools/api_contracts.py",
      "sha": "18f945623ecca50dcbbd33c0443b9e48d9ed801b",
      "url": "https://github.com/AceDataCloud/GPTImageDify/blob/main/tools/api_contracts.py",
      "local": "/tmp/ace-hf-top5-contracts-20261018/GPTImageDify-tools_api_contracts.py",
      "excerpt": "\"\"\"Published API contracts; source revisions are recorded in tests/parity-audit.json.\"\"\"\n\nTASK_PATH = \"/openai/tasks\"\n\nENDPOINTS = {\n    \"gpt_image_generate_image\": {\n        \"method\": \"POST\",\n        \"path\": \"/openai/images/generations\",\n        \"operation\": \"generate\",\n        \"schema\": {\n            \"type\": \"object\",\n            \"required\": [\"prompt\", \"model\"],\n            \"properties\": {\n                \"prompt\": {\"type\": \"string\"},\n                \"background\": {\"enum\": [\"transparent\", \"opaque\", \"auto\"], \"type\": \"string\"},\n                \"model\": {\n                    \"enum\": [\n                        \"dall-e-2\",\n                        \"dall-e-3\",\n                        \"gpt-image-1\",\n                        \"gpt-image-1.5\",\n                        \"gpt-image-2\",\n                        \"gpt-image-2.5-flare\",\n                        \"gpt-image-2.5-flare:official\",\n                        \"gpt-image-2.5-sunburst\",\n                        \"gpt-image-2.5-sunburst:official\",\n                        \"gpt-image-2:reverse\",\n                        \"gpt-image-2:official\",\n                        \"nano-banana\",\n                        \"nano-banana-2-lite\",\n                        \"nano-banana-2\",\n                        \"nano-banana-pro\",\n                    ],\n                    \"type\": \"string\",\n                },\n                \"moderation\": {\"enum\": [\"low\", \"auto\"], \"type\": \"string\"},\n                \"n\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 10},\n                "
    },
    {
      "repo": "AceDataCloud/NanoBananaDify",
      "path": "tools/api_contracts.py",
      "sha": "2a93e9241db772abe4cc7018a3bb0b1412d4c6aa",
      "url": "https://github.com/AceDataCloud/NanoBananaDify/blob/main/tools/api_contracts.py",
      "local": "/tmp/ace-hf-top5-contracts-20261018/NanoBananaDify-tools_api_contracts.py",
      "excerpt": "\"\"\"Published API contracts; source revisions are recorded in tests/parity-audit.json.\"\"\"\n\nTASK_PATH = \"/nano-banana/tasks\"\n\nENDPOINTS = {\n    \"nano_banana_generate_image\": {\n        \"method\": \"POST\",\n        \"path\": \"/nano-banana/images\",\n        \"operation\": \"generate\",\n        \"schema\": {\n            \"type\": \"object\",\n            \"required\": [\"action\", \"prompt\"],\n            \"properties\": {\n                \"action\": {\"enum\": [\"generate\", \"edit\"], \"type\": \"string\"},\n                \"model\": {\n                    \"type\": \"string\",\n                    \"enum\": [\n                        \"nano-banana\",\n                        \"nano-banana-2-lite\",\n                        \"nano-banana-2\",\n                        \"nano-banana-2.1\",\n                        \"nano-banana-pro\",\n                        \"nano-banana:official\",\n                        \"nano-banana-2-lite:official\",\n                        \"nano-banana-2:official\",\n                        \"nano-banana-pro:official\",\n                    ],\n                },\n                \"prompt\": {\"type\": \"string\"},\n                \"image_urls\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}},\n                \"count\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 4},\n                \"aspect_ratio\": {\n                    \"type\": \"string\",\n                    \"enum\": [\"1:1\", \"3:2\", \"2:3\", \"16:9\", \"9:16\", \"4:3\", \"3:4\"],\n                },\n                \"resolution\": {\"type\": \"string\", \"enum\": [\"1K\", \"2K\", \"4K\"]},\n                \"callback_"
    }
