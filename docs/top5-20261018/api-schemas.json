                        "douyin",
                        "moji",
                        "search_engine"
                      ]
                    }
                  }
                }
              }
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "safety_identifier": {
              "type": "string",
              "maxLength": 64
